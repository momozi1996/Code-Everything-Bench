# Copy to .env (git-ignored) and fill in ONLY the values you need.
# Never commit .env. The benchmark reads keys from environment variables named
# by `api_key_env` in config/models.json — keys never live in a tracked file.
#
#   cp .env.example .env
#   # edit .env
#   set -a; source .env; set +a
#   python3 scripts/run_evaluation.py --check

# Official / common providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Self-hosted open-weight endpoint (e.g. vLLM / SGLang / Ollama OpenAI shim)
CEBENCH_LOCAL_API_KEY=
CEBENCH_LOCAL_BASE_URL=http://localhost:8000/v1

# Any third-party gateway or aggregation service
CEBENCH_CUSTOM_API_KEY=
CEBENCH_CUSTOM_BASE_URL=

# Optional: a shared secret for a gateway that needs an extra header
CEBENCH_CUSTOM_EXTRA_HEADER=
