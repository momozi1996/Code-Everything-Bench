# macOS (explicitly excluded from every commit)
*.DS_Store
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Browser / runner scratch (never commit transient traces)
.playwright/
playwright-report/
test-results/
tmp/
*.log

# Local secrets and personal run configuration — templates are tracked,
# filled-in copies are not. Keys are read from environment variables only.
.env
.env.*
!.env.example
config/models.json
config/run.json

# Upstream corpus snapshot is fetched on demand by scripts/sync_corpus.py.
# The two derived files below are NOT upstream snapshots: they hold the
# newly parsed Feishu prompts and must be versioned so `expand_tasks.py`
# can reproduce the Extended tier from a fresh clone.
data/corpus/*
!data/corpus/extension.jsonl
!data/corpus/feishu_md_records.jsonl
# 2026-11-25 X / Vibe3D prompt batch: versioned so a fresh clone can
# reproduce the +78 Extended tasks (import_x_batch.py / build_catalog.py).
!data/corpus/x_batch_2026-11-25.jsonl
!data/corpus/x_batch_2026-11-25_triage.jsonl

# NOTE: results/, leaderboard/data/ and tasks/manifest.json are intentionally
# NOT ignored. Reproducibility requires that traces and placeholder data are
# versioned. Only the transient paths above are excluded.
